{
  "name": "sherkty",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && esbuild server/index.ts --bundle --format=esm --outfile=out/_worker.js --external:node:* && node scripts/finalize.mjs",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply ERP_DB --local",
    "serve": "wrangler pages dev out --port 8788",
    "test": "esbuild src/schema.ts --format=esm --outfile=tests/schema.mjs && node tests/integration.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "hono": "^4.7.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
